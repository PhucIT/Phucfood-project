# Cấu hình MySQL Docker cho dự án PHUC-FOODIE
# Sao chép file này thành .env.mysql và cập nhật mật khẩu trước khi chạy

# Thông tin Database và User ứng dụng
MYSQL_DATABASE=phuc_foodie
MYSQL_USER=foodie_user
MYSQL_PASSWORD=replace_with_strong_password_for_foodie_user

# Mật khẩu quản trị viên root của MySQL
MYSQL_ROOT_PASSWORD=replace_with_strong_password_for_root

# Cổng ánh xạ ra máy chủ Windows
MYSQL_PORT=3308
MYSQL_HOST=127.0.0.1
