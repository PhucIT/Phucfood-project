# Dùng khi triển khai với Docker. Tên miền của bạn phải trỏ tới server.
DOMAIN=foodie.example.com
# Có thể bỏ SECRET_KEY: server tự tạo khóa tại data/session.key và lưu bền vững.
# Không chia sẻ session.key hay mật khẩu SMTP.
# Email đặt lại mật khẩu chỉ bật khi SMTP_HOST và SMTP_FROM được cấu hình.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
